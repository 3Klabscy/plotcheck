{
  "name": "plotcheck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plot feasibility platform — phase 1 prototype",
  "workspaces": [
    "packages/*",
    "packages/countries/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint packages apps/api-dev",
    "dev:api": "tsx apps/api-dev/src/server.ts",
    "dev:web": "npm --workspace @plotcheck/app run web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
